{
  "expo": {
    "name": "Magneto BLE",
    "slug": "magneto-ble",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.magnetoble",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Bluetooth is used to connect to your magnetic field sensor."
      }
    },
    "android": {
      "package": "com.example.magnetoble",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Bluetooth is used to connect to your magnetic field sensor."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4550a434-bddb-4c1d-8be7-d234e949334e"
      }
    },
    "owner": "bkwint"
  }
}
